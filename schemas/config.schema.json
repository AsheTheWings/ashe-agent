{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ashe-agent config file",
  "type": "object",
  "properties": {
    "stateDir": {
      "type": "string",
      "pattern": "^\\/",
      "description": "Directory holding the server's database and other state."
    },
    "listenHost": {
      "type": "string",
      "minLength": 1,
      "description": "Address the WebSocket server listens on."
    },
    "listenPort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535,
      "description": "Port the WebSocket server listens on; 0 picks a free port."
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "baseURL": {
            "type": "string"
          },
          "apiKeyFile": {
            "type": "string",
            "pattern": "^\\/"
          },
          "models": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "limit": {
                  "type": "object",
                  "properties": {
                    "context": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "context"
                  ],
                  "additionalProperties": false
                },
                "capabilities": {
                  "type": "object",
                  "properties": {
                    "input": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "enum": [
                          "text",
                          "image"
                        ]
                      }
                    },
                    "temperature": {
                      "type": "boolean"
                    },
                    "reasoning": {
                      "type": "object",
                      "properties": {
                        "efforts": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "efforts"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "input"
                  ],
                  "additionalProperties": false
                },
                "checkpointWindowSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "temperature": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "reasoningEffort": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "limit",
                "capabilities"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "baseURL",
          "apiKeyFile",
          "models"
        ],
        "additionalProperties": false
      },
      "description": "OpenAI Responses endpoints by provider id, each with its base URL, the protected file of its API key, and its models by upstream model id."
    },
    "defaultModel": {
      "type": "string",
      "description": "The <provider>/<model> id sessions start with when neither the request nor the agent names a model."
    },
    "auxiliaryModels": {
      "type": "object",
      "properties": {
        "handoff": {
          "type": "string"
        },
        "compaction": {
          "type": "string"
        },
        "research": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "description": "Optional <provider>/<model> ids for the handoff, compaction, and research tasks."
    },
    "origins": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Browser origins allowed to open a WebSocket connection."
    },
    "githubClientId": {
      "type": "string",
      "minLength": 1,
      "description": "Client ID of the GitHub OAuth app the owner signs in through."
    },
    "githubClientSecretFile": {
      "type": "string",
      "pattern": "^\\/",
      "description": "Path of the protected file holding the GitHub OAuth app's client secret."
    },
    "githubCallbackUrl": {
      "type": "string",
      "description": "The server's sign-in callback URL, <server origin>/v1/auth/github/callback, as the OAuth app registers it."
    },
    "githubOwnerId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Numeric GitHub user ID of the owner, the only account that signs in."
    },
    "githubUrl": {
      "type": "string",
      "description": "Base URL of GitHub's authorize and token endpoints."
    },
    "githubApiUrl": {
      "type": "string",
      "description": "Base URL of GitHub's REST API."
    },
    "devWebAllowedHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Host names the development web server answers besides its loopback address."
    },
    "devWebServerUrl": {
      "type": "string",
      "description": "WebSocket endpoint the development web client connects to."
    },
    "permission": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "enum": [
                    "allow",
                    "ask",
                    "deny"
                  ]
                }
              }
            ]
          }
        }
      ],
      "description": "Permission rules in opencode's shape; a tool call no rule matches is allowed."
    },
    "shellEnvFile": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\/"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional script every shell command sources before it runs."
    },
    "shellYieldMs": {
      "type": "integer",
      "minimum": 250,
      "maximum": 30000,
      "description": "Milliseconds a shell command runs before it yields, unless its call says otherwise."
    },
    "shellMaxOutputTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Estimated tokens a shell result holds, unless its call says otherwise."
    },
    "shellMaxProcesses": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991,
      "description": "Shell processes a session holds at most."
    },
    "instructionsFile": {
      "type": "string",
      "pattern": "^\\/",
      "description": "Global instructions file, the user instructions of sessions whose agent has no title file."
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "models": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "checkpointWindowSize": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "temperature": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 2
                },
                "reasoningEffort": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "permission": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              },
              {
                "type": "object",
                "additionalProperties": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "allow",
                        "ask",
                        "deny"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "enum": [
                          "allow",
                          "ask",
                          "deny"
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "Agents by title, each with an optional starting model, per-model setting overrides, and permission rules."
    },
    "defaultAgent": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional title of the agent sessions created without one run as."
    },
    "titlesDir": {
      "type": "string",
      "pattern": "^\\/",
      "description": "Directory of title files, <title>.md, holding each agent's description and user instructions."
    },
    "scratchRoot": {
      "type": "string",
      "pattern": "^\\/",
      "description": "Directory holding each session's scratch directory, for reproducible and disposable files."
    },
    "userTimeZone": {
      "type": "string",
      "minLength": 1,
      "description": "The user's IANA time zone, in which session facts give the user's date."
    },
    "skillRoots": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\/"
      },
      "description": "Directories searched for skills, the first winning a duplicate name."
    },
    "mcpServers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "stdio"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "envFile": {
                "type": "string",
                "pattern": "^\\/"
              },
              "codemode": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            },
            "required": [
              "type",
              "command"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "http"
                ]
              },
              "url": {
                "type": "string"
              },
              "headersFile": {
                "type": "string",
                "pattern": "^\\/"
              },
              "codemode": {
                "type": "boolean",
                "enum": [
                  false
                ]
              }
            },
            "required": [
              "type",
              "url"
            ],
            "additionalProperties": false
          }
        ]
      },
      "description": "MCP servers by name: stdio commands or Streamable HTTP URLs."
    },
    "codeModeLimits": {
      "type": "object",
      "properties": {
        "wallClockMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "toolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false,
      "description": "Optional limits on a code mode program's time, tool calls, and output bytes."
    },
    "exaBaseUrl": {
      "type": "string",
      "description": "Base URL of the Exa API behind the web tools."
    },
    "exaApiKeyFile": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\/"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional path of the protected file holding the Exa API key; without it the web tools are off."
    },
    "tracesExporter": {
      "type": "string",
      "enum": [
        "otlp",
        "console",
        "none"
      ],
      "description": "Trace exporter: otlp, console, or none."
    },
    "metricsExporter": {
      "type": "string",
      "enum": [
        "otlp",
        "console",
        "none"
      ],
      "description": "Metric exporter: otlp, console, or none."
    },
    "logsExporter": {
      "type": "string",
      "enum": [
        "otlp",
        "console",
        "none"
      ],
      "description": "Log exporter: otlp, console, or none."
    },
    "otlpEndpoint": {
      "type": "string",
      "description": "OTLP endpoint the otlp exporters send to."
    },
    "otlpProtocol": {
      "type": "string",
      "enum": [
        "http/protobuf",
        "http/json"
      ],
      "description": "OTLP transport protocol."
    },
    "otlpHeadersFile": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\/"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional path of the protected file holding OTLP export headers as key=value pairs."
    },
    "deploymentEnvironment": {
      "type": "string",
      "minLength": 1,
      "description": "Value of the deployment.environment.name telemetry attribute."
    }
  },
  "additionalProperties": false
}
