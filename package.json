{
  "name": "ashe-agent-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "gate": "bun scripts/task.ts gate",
    "typecheck": "bun scripts/task.ts typecheck",
    "test:unit": "bun scripts/task.ts test:unit",
    "test:component": "bun scripts/task.ts test:component",
    "test:integration": "bun scripts/task.ts test:integration",
    "test:conformance": "bun scripts/task.ts test:conformance",
    "test:test262": "bun scripts/task.ts test:test262",
    "dev:web": "bun scripts/task.ts dev:web",
    "build:web": "bun scripts/task.ts build:web",
    "build:binary": "bun scripts/task.ts build:binary",
    "bundle": "bun scripts/task.ts bundle",
    "test:qualification": "bun scripts/task.ts test:qualification",
    "test:web-image": "bun scripts/task.ts test:web-image",
    "web-image": "bun scripts/task.ts web-image",
    "release-gate": "bun scripts/task.ts release-gate",
    "generate": "bun scripts/task.ts generate"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "ajv": "8.20.0",
    "typescript": "7.0.2"
  }
}
