# Generated from packages/harness/src/inputs/catalog.ts by `bun run generate`; do not edit.
# Development defaults of every process input, for reading only: no process or tool loads this file.
# An input shown as `# NAME=` has no development default and is required where its process uses it.
# An input shown as `# NAME= (optional)` is unset by default and may stay unset.

# Profile selecting the defaults: development or production. It has no default. Used by: serve, migrate, db, token, devWeb, webServe, webMigrate, webDb.
# ASHE_AGENT_PROFILE=

# Path of the JSON config file, an overlay layer of these inputs. Used by: serve, migrate, db, token, devWeb, webServe, webMigrate, webDb.
ASHE_AGENT_CONFIG_FILE=$XDG_CONFIG_HOME/ashe-agent/config.json

# Directory holding the server's database and other state. Used by: serve, migrate, db, token.
ASHE_AGENT_STATE_DIR=$XDG_STATE_HOME/ashe-agent

# Address the WebSocket server listens on. Used by: serve.
ASHE_AGENT_LISTEN_HOST=127.0.0.1

# Port the WebSocket server listens on; 0 picks a free port. Used by: serve.
ASHE_AGENT_LISTEN_PORT=7420

# OpenAI Responses endpoints by provider id, each with its base URL, the protected file of its API key, and its models by upstream model id. Used by: serve.
# ASHE_AGENT_PROVIDERS=

# The <provider>/<model> id sessions start with when neither the request nor the agent names a model. Used by: serve.
# ASHE_AGENT_DEFAULT_MODEL=

# Optional <provider>/<model> ids for the handoff, compaction, and research tasks. Used by: serve.
ASHE_AGENT_AUXILIARY_MODELS={}

# Browser origins allowed to open a WebSocket connection. Used by: serve.
ASHE_AGENT_ORIGINS=["http://127.0.0.1:5173"]

# Client ID of the GitHub OAuth app the owner signs in through. Used by: serve.
# ASHE_AGENT_GITHUB_CLIENT_ID=

# Path of the protected file holding the GitHub OAuth app's client secret. Used by: serve.
# ASHE_AGENT_GITHUB_CLIENT_SECRET_FILE=

# The server's sign-in callback URL, <server origin>/v1/auth/github/callback, as the OAuth app registers it. Used by: serve.
# ASHE_AGENT_GITHUB_CALLBACK_URL=

# Numeric GitHub user ID of the owner, the only account that signs in. Used by: serve.
# ASHE_AGENT_GITHUB_OWNER_ID=

# Base URL of GitHub's authorize and token endpoints. Used by: serve.
ASHE_AGENT_GITHUB_URL=https://github.com

# Base URL of GitHub's REST API. Used by: serve.
ASHE_AGENT_GITHUB_API_URL=https://api.github.com

# Host names the development web server answers besides its loopback address. Used by: devWeb.
ASHE_AGENT_DEV_WEB_ALLOWED_HOSTS=[]

# WebSocket endpoint the development web client connects to. Used by: devWeb.
ASHE_AGENT_DEV_WEB_SERVER_URL=ws://127.0.0.1:7420/v1/ws

# Permission rules in opencode's shape; a tool call no rule matches is allowed. Used by: serve.
ASHE_AGENT_PERMISSION={}

# Optional script every shell command sources before it runs. Used by: serve.
# ASHE_AGENT_SHELL_ENV_FILE= (optional)

# Milliseconds a shell command runs before it yields, unless its call says otherwise. Used by: serve.
ASHE_AGENT_SHELL_YIELD_MS=10000

# Estimated tokens a shell result holds, unless its call says otherwise. Used by: serve.
ASHE_AGENT_SHELL_MAX_OUTPUT_TOKENS=10000

# Shell processes a session holds at most. Used by: serve.
ASHE_AGENT_SHELL_MAX_PROCESSES=64

# Global instructions file, the user instructions of sessions whose agent has no title file. Used by: serve.
ASHE_AGENT_INSTRUCTIONS_FILE=$XDG_CONFIG_HOME/ashe-agent/AGENTS.md

# Agents by title, each with an optional starting model, per-model setting overrides, and permission rules; the key untitled is reserved. Used by: serve.
ASHE_AGENT_AGENTS={}

# Optional title of the agent sessions created without one run as; the synthetic untitled title is not configurable. Used by: serve.
# ASHE_AGENT_DEFAULT_AGENT= (optional)

# Directory of title files, <title>.md, holding each agent's description and user instructions. Used by: serve.
ASHE_AGENT_TITLES_DIR=$XDG_CONFIG_HOME/ashe-agent/titles

# Directory holding each session's scratch directory, for reproducible and disposable files. Used by: serve.
ASHE_AGENT_SCRATCH_ROOT=$XDG_CACHE_HOME/ashe-agent/scratch

# The user's IANA time zone, in which session facts give the user's date. Used by: serve.
ASHE_AGENT_USER_TIME_ZONE=UTC

# Directories searched for skills, the first winning a duplicate name. Used by: serve.
ASHE_AGENT_SKILL_ROOTS=["$HOME/.agents/skills","$XDG_CONFIG_HOME/ashe-agent/skills"]

# MCP servers by name: stdio commands or Streamable HTTP URLs. Used by: serve.
ASHE_AGENT_MCP_SERVERS={}

# Optional limits on a code mode program's tool calls and output bytes. Used by: serve.
ASHE_AGENT_CODE_MODE_LIMITS={}

# Largest submitted original file the harness accepts. Used by: serve.
ASHE_AGENT_CONTENT_MAX_ORIGINAL_BYTES=33554432

# Largest submitted image original the harness accepts. Used by: serve.
ASHE_AGENT_CONTENT_MAX_IMAGE_BYTES=20971520

# Most attachments one submission may hold. Used by: serve.
ASHE_AGENT_CONTENT_MAX_ATTACHMENTS=10

# Largest combined original bytes one submission may hold. Used by: serve.
ASHE_AGENT_CONTENT_MAX_SUBMISSION_BYTES=134217728

# Bytes a tool producer may collect before recording capture loss. Used by: serve.
ASHE_AGENT_CONTENT_COLLECTION_BYTES=1048576

# Lines of oversized retained text a model observation includes. Used by: serve.
ASHE_AGENT_CONTENT_PREVIEW_LINES=2000

# Bytes of oversized retained text a model observation includes. Used by: serve.
ASHE_AGENT_CONTENT_PREVIEW_BYTES=51200

# Most PDF pages one fallback model observation includes. Used by: serve.
ASHE_AGENT_CONTENT_PDF_PAGES_PER_WINDOW=8

# Dots per inch used to render fallback PDF pages. Used by: serve.
ASHE_AGENT_CONTENT_PDF_DPI=144

# Longest pixel edge of one rendered PDF page. Used by: serve.
ASHE_AGENT_CONTENT_PDF_MAX_LONG_EDGE=2048

# Most pixels one rendered PDF page may allocate. Used by: serve.
ASHE_AGENT_CONTENT_PDF_MAX_PIXELS_PER_PAGE=4194304

# Estimated token allowance for one native PDF contribution. Used by: serve.
ASHE_AGENT_CONTENT_PDF_DOCUMENT_TOKENS=2000

# Estimated token allowance for one model-facing image. Used by: serve.
ASHE_AGENT_CONTENT_IMAGE_TOKENS=1500

# Unclaimed upload staging bytes allowed for one owner. Used by: serve.
ASHE_AGENT_CONTENT_UPLOAD_QUOTA_BYTES=536870912

# Milliseconds after creation that unclaimed upload staging expires. Used by: serve.
ASHE_AGENT_CONTENT_UPLOAD_EXPIRY_MS=86400000

# Largest bytes one upload append may send. Used by: serve.
ASHE_AGENT_CONTENT_UPLOAD_CHUNK_BYTES=1048576

# util-linux prlimit executable that launches conversion workers. Used by: serve.
ASHE_AGENT_CONVERSION_PRLIMIT_PATH=/usr/bin/prlimit

# RLIMIT_DATA private-allocation ceiling for one conversion worker. Used by: serve.
ASHE_AGENT_CONVERSION_DATA_LIMIT_BYTES=536870912

# RLIMIT_STACK ceiling for one conversion worker. Used by: serve.
ASHE_AGENT_CONVERSION_STACK_LIMIT_BYTES=8388608

# RLIMIT_CPU seconds for one conversion worker. Used by: serve.
ASHE_AGENT_CONVERSION_CPU_SECONDS=20

# Milliseconds after launch when the parent terminates a conversion worker. Used by: serve.
ASHE_AGENT_CONVERSION_WALL_MS=30000

# Largest result bytes one conversion worker may return. Used by: serve.
ASHE_AGENT_CONVERSION_OUTPUT_BYTES=134217728

# Conversion workers the harness runs concurrently. Used by: serve.
ASHE_AGENT_CONVERSION_ACTIVE_WORKERS=2

# Reference-only conversion jobs the harness queues. Used by: serve.
ASHE_AGENT_CONVERSION_QUEUED_JOBS=16

# Shortest accepted session wait, in milliseconds; shorter requests clamp. Used by: serve.
ASHE_AGENT_COMMUNICATION_WAIT_MIN_MS=10000

# session.wait timeout when the call omits one, in milliseconds. Used by: serve.
ASHE_AGENT_COMMUNICATION_WAIT_DEFAULT_MS=30000

# Longest accepted session wait, in milliseconds; longer requests fail. Used by: serve.
ASHE_AGENT_COMMUNICATION_WAIT_MAX_MS=3600000

# Official sqlite3 executable used for bounded read-only session discovery. Used by: serve.
ASHE_AGENT_SQLITE3_PATH=/usr/bin/sqlite3

# Elapsed milliseconds one tool invocation may take, including validation, permission waits, and effects. Used by: serve.
ASHE_AGENT_TOOL_TIMEOUT_MS=300000

# Elapsed-time limits by exact registered tool name; null disables a tool's local limit. Used by: serve.
ASHE_AGENT_TOOL_TIMEOUT_OVERRIDES={}

# Base URL of the Exa API behind the web tools. Used by: serve.
ASHE_AGENT_EXA_BASE_URL=https://api.exa.ai

# Optional path of the protected file holding the Exa API key; without it the web tools are off. Used by: serve.
# ASHE_AGENT_EXA_API_KEY_FILE= (optional)

# Trace exporter: otlp, console, or none. Used by: serve, webServe.
OTEL_TRACES_EXPORTER=otlp

# Metric exporter: otlp, console, or none. Used by: serve, webServe.
OTEL_METRICS_EXPORTER=otlp

# Log exporter: otlp, console, or none. Used by: serve, webServe.
OTEL_LOGS_EXPORTER=otlp

# OTLP endpoint the otlp exporters send to. Used by: serve, webServe.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# OTLP transport protocol. Used by: serve, webServe.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# Optional path of the protected file holding OTLP export headers as key=value pairs. Used by: serve, webServe.
# ASHE_AGENT_OTLP_HEADERS_FILE= (optional)

# Value of the deployment.environment.name telemetry attribute. Used by: serve, webServe.
ASHE_AGENT_DEPLOYMENT_ENVIRONMENT=development

# Directory holding the built-in web application's SQLite state and dumps. Used by: webServe, webMigrate, webDb.
ASHE_AGENT_WEB_STATE_DIR=$XDG_STATE_HOME/ashe-agent/web

# Address the built-in web backend listens on. Used by: webServe.
ASHE_AGENT_WEB_LISTEN_HOST=127.0.0.1

# Port the built-in web backend listens on; 0 picks a free port. Used by: webServe.
ASHE_AGENT_WEB_LISTEN_PORT=7430

# WebSocket URL of the harness whose sessions the web backend observes and validates credentials against. Used by: webServe.
ASHE_AGENT_WEB_HARNESS_URL=ws://127.0.0.1:7420/v1/ws

# Browser origins allowed to use the built-in web backend. Used by: webServe.
ASHE_AGENT_WEB_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:7430"]

# Path of the protected file holding the harness credential the web backend observes with. Used by: webServe.
# ASHE_AGENT_WEB_OBSERVER_CREDENTIAL_FILE= (optional)

# Root of the immutable built browser assets the web backend serves. Used by: webServe.
# ASHE_AGENT_WEB_ASSETS_DIR= (optional)

# Directory of the web backend's ordered SQLite migrations. Used by: webServe, webMigrate, webDb.
# ASHE_AGENT_WEB_MIGRATIONS_DIR= (optional)

# Days without observed work before the web inbox files an unpinned session; 0 disables filing. Used by: webServe.
ASHE_AGENT_WEB_INACTIVITY_DAYS=3

# Protected inputs are read only from the files their path inputs name:
#   Client secret of the GitHub OAuth app. File: ASHE_AGENT_GITHUB_CLIENT_SECRET_FILE.
#   API key sent to Exa as x-api-key. File: ASHE_AGENT_EXA_API_KEY_FILE.
#   OTLP export headers, which may carry credentials. File: ASHE_AGENT_OTLP_HEADERS_FILE.
#   Harness credential used by the web backend's observer connection. File: ASHE_AGENT_WEB_OBSERVER_CREDENTIAL_FILE.
