# The built-in application's backend and frontend from one revision.
# scripts/image.sh copies the production build under site/.
FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc

COPY site/ /app/
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/bin/ashe-agent-web"]
CMD ["serve"]
