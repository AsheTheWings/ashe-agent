# The web client's static files behind Caddy. scripts/image.sh builds it
# from a context holding the client's production build in site/ and this
# directory's caddy.json.
FROM docker.io/library/caddy:2.11.7@sha256:04913b1da43339a40ad1ea87827d70a576ac5aa6cf674c6e24fdca675887533a

COPY caddy.json /etc/caddy/caddy.json
COPY site/ /srv/web/
# The base image's caddy carries the NET_BIND_SERVICE file capability, which
# a container without capabilities cannot execute; the copy has none.
RUN cp /usr/bin/caddy /usr/local/bin/caddy

# Caddy needs no privilege to listen above 1024; /data and /config are its
# only writable paths, which a read-only container mounts as tmpfs.
USER 65532:65532
EXPOSE 8080
CMD ["/usr/local/bin/caddy", "run", "--config", "/etc/caddy/caddy.json"]
