{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],
    "jsx": "react-jsx",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/client/**/*.ts",
    "src/client/**/*.tsx",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/session/**/*.ts",
    "src/shared/**/*.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/chat/**/*.ts",
    "src/chat/**/*.tsx",
    "src/hooks/**/*.ts"
    ,"test/**/*.ts"
  ]
}
